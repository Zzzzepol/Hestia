PORT=3000
NODE_ENV=development
# Use the direct IPv6 endpoint for a persistent API when the host has IPv6 access.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&connection_limit=5&connect_timeout=10&pool_timeout=20
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# If the API host cannot reach IPv6, use the Supabase session pooler as DATABASE_URL instead.
# DATABASE_URL_POOLER=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=5&connect_timeout=10&pool_timeout=20
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY_HOPS=0
PHOTO_BUCKET=item-photos
